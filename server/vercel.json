{
  
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination":"server" 
      },
    
    {
      "source": "/(.*)",
      "destination": "client" 
        
      }
    
  ]
}